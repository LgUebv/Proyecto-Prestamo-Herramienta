# Configuración para ejecutar el proyecto con Docker.
# Copia este archivo a .env.docker (no se sube a git) y ajusta los valores.
# Tu .env local no se modifica ni se usa dentro de los contenedores.

APP_NAME=PrestamoHerramientasTSJ
APP_ENV=production
APP_DEBUG=false
# Genérala con: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Debe coincidir con la URL desde la que accedes (incluye el puerto)
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base de datos --------------------------------------------------------
# DB_HOST y DB_PORT los fija compose.yaml (apuntan al servicio "db").
# IMPORTANTE: los valores DB_* (Laravel) y MYSQL_* (contenedor de MySQL)
# deben coincidir. No uses ${...} aquí: Docker Compose los resolvería con tu
# .env local en lugar de con este archivo.
DB_DATABASE=herramientas_db
DB_USERNAME=herramientas
DB_PASSWORD=cambia_esta_contrasena

MYSQL_DATABASE=herramientas_db
MYSQL_USER=herramientas
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- Sesión, caché y colas (igual que en desarrollo: en base de datos) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="PrestamoHerramientasTSJ"

VITE_APP_NAME="PrestamoHerramientasTSJ"

# Ejecutar migraciones automáticamente al arrancar el contenedor
RUN_MIGRATIONS=true
